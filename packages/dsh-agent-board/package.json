{
  "name": "dsh-agent-board",
  "description": "DeepSeek Harness 智能看板：任务卡片 + 一次性 Worker/Verifier 派发 + 依赖调度 + 管线分档 + Team 模式（歧义上报主窗口裁决）",
  "version": "1.7.6",
  "type": "module",
  "main": "./index.mjs",
  "scripts": {
    "build-client": "node scripts/build-client.cjs",
    "test": "node --test test/**/*.test.mjs",
    "pretest": "npm run build-client",
    "sync-readme": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\"",
    "prepublishOnly": "npm run build-client && node --check index.mjs && node --check lib/client.js && node --check lib/core.mjs && npm test",
    "pree2e": "npm run build-client",
    "e2e": "node scripts/e2e.cjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.mjs",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "test/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-board",
    "kanban",
    "agent",
    "subagent",
    "multi-agent",
    "ai-agent",
    "task-dispatch",
    "workflow",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PPawnsir/task-board-plugin.git",
    "directory": "packages/dsh-agent-board"
  },
  "homepage": "https://github.com/PPawnsir/task-board-plugin#readme",
  "bugs": "https://github.com/PPawnsir/task-board-plugin/issues",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18",
    "@deepseek-ai/dsh": "^0.1.7 || 0.2.0-rc.2 || ^0.2.0"
  },
  "license": "MIT"
}
